{
  "name": "backend",
  "module": "index.ts",
  "private": true,
  "scripts": {
    "docker:dev": "docker compose -f docker-compose-dev.yml up",
    "docker:test": "docker compose -f docker-compose-test.yml up --build",
    "docker:stop": "docker compose -f docker-compose-dev.yml stop",
    "docker:down": "docker compose -f docker-compose-dev.yml down",
    "docker:stop:test": "docker compose -f docker-compose-test.yml stop",
    "docker:down:test": "docker compose -f docker-compose-test.yml down",
    
    "dev": "bun run --watch src/app.ts",
    "dev:api": "bun run --watch src/app.ts --api",
    "test": "bun test",
    "test:coverage": "bun test --coverage",

    "dev:local": "bun run --env-file=.env.local --watch src/app.ts --api",
    "test:local": "bun test --env-file=.env.test.local",
    "test:coverage:local": "bun test --coverage --env-file=.env.test.local",
    
    "start": "bun run src/app.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "3.0.0",
    "@types/bun": "latest",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "supertest": "7.2.2"
  },
  "peerDependencies": {
    "typescript": "5"
  },
  "dependencies": {
    "@types/swagger-jsdoc": "6.0.4",
    "bcryptjs": "3.0.3",
    "colors": "1.4.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "env-var": "7.5.0",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.10.1",
    "pg": "8.18.0",
    "pg-hstore": "2.3.4",
    "reflect-metadata": "0.2.2",
    "sequelize": "6.37.7",
    "sequelize-typescript": "2.1.6",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1"
  },
  "engines": {
    "node": "22.x.x"
  }
}