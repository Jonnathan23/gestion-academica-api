{
    "env": {
        "node": true,
        "es2022": true
    },
    "extends": [
        "airbnb-base",
        "prettier"
    ],
    "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module"
    },
    "plugins": [
        "prettier",
        "check-file"
    ],
    "rules": {
        "prettier/prettier": "error",
        "arrow-body-style": 0,
        "no-console": [
            "error",
            {
                "allow": [
                    "warn",
                    "error"
                ]
            }
        ],
        "no-underscore-dangle": 0,
        "no-useless-catch": 0,
        "check-file/filename-naming-convention": [
            "error",
            {
                "src/**/*.{js,ts}": "KEBAB_CASE"
            },
            {
                "ignoreMiddleExtensions": true
            }
        ],
        "check-file/folder-naming-convention": [
            "error",
            {
                "src/**/": "KEBAB_CASE"
            }
        ]
    },
    "ignorePatterns": [
        "node_modules",
        "dist"
    ]
}